    }
      class Proces:::procedure {
        string uuid
        string uri
        Date aangemaaktOp
        string benaming
        Procedure type
        ProcesVariabele[] heeftInvoer 
        ProcesVariabele[] heeftUitvoer 
        Proces[] onderdeelVan 
        ISysteem geimplementeerdDoor 
    }
      class ProcesVariabele {
        string uuid
        string uri
        Date aangemaaktOp
        string benaming
        string type
        number eenheid
        string waarde
    }
      class ISysteem:::system {
        <<interface>>
        string uuid
        string uri
    }

    class Procedure:::procedure {
        <<enumerable>>
        VERWERKING
        TRANSPORT
        VERBRUIK
        EMISSIE
    }
    Proces --> Procedure : type

    ISysteem <|.. Apparaat
    ISysteem <|.. Emissiepunt
    ISysteem <|.. Installatie
    ISysteem <|.. Meetpunt
    ISysteem <|.. Onttrekkingspunt
    Proces --> ProcesVariabele : heeft invoer
    Proces --> ProcesVariabele : heeft uitvoer
    Proces --> Proces : onderdeel van
    Proces --> ISysteem : geimplementeerd door
    Installatie --> ISysteem : heeft subsysteem
    Installatie --> Proces : implementeert

    %% System green
    classDef system fill:#cfc,stroke:#333,stroke-width:1px
    %% Procedure blue
    classDef procedure fill:#ccf,stroke:#333,stroke-width:1px
