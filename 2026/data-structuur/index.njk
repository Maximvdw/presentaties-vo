      PROCES2["**Proces** <br> type=VERWERKING <br> benaming=Brood bakken"]
    
      PROCES1 -->|"heeftInvoer"| STOF1
      PROCES1 -->|"heeftInvoer"| STOF2
      OVERBRENGING1["**Proces** <br> type=TRANSPORT"]
