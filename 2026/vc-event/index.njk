                <tr><td>Economie</td><td>Steunaanvraag</td><td>Ontvankelijkheid</td><td>Dossierbehandelaar</td><td>Beoordelingskader</td><td>Ontvankelijk</td></tr>
                <tr><td>Cultuur</td><td>Museum</td><td>Aantal bezoekers</td><td>Ticketsysteem</td><td>Scan aan de ingang</td><td>1 240 per dag</td></tr>
                <tr><td>Omgeving</td><td>De Dender</td><td>Nitraatgehalte</td><td>Labo</td><td>Analysemethode</td><td>8,1 mg/l</td></tr>
