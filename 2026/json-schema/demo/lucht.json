{
  "$id": "/2026/json-schema/demo/lucht.json",
  "description": "RIE-IEPR observatie voor lucht",
  "type": "object",
  "properties": {
    "resultTime": {
      "$ref": "/2026/json-schema/demo/observatie.json#/properties/resultTime"
    },
    "hasFeatureOfInterest": {
      "$ref": "/2026/json-schema/demo/observatie.json#/properties/hasFeatureOfInterest"
    },
    "observedProperty": {
      "allOf": [
        {
          "$ref": "/2026/json-schema/demo/observatie.json#/properties/observedProperty"
        },
        {
          "type": "string",
          "enum": [
            "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/relatieveVochtigheid",
            "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/temperatuur"
          ]
        }
      ]
    },
    "hasResult": {
      "allOf": [
        {
          "$ref": "/2026/json-schema/demo/observatie.json#/properties/hasResult"
        },
        {
          "type": "object"
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "/2026/json-schema/demo/observatie.json"
    },
    {
      "if": {
        "properties": {
          "observedProperty": {
            "const": "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/relatieveVochtigheid"
          }
        }
      },
      "then": {
        "properties": {
          "hasResult": {
            "type": "object",
            "properties": {
              "hasNumericalValue": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "hasUnit": {
                "const": "http://qudt.org/vocab/unit/PERCENT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observedProperty": {
            "const": "https://data.riepr.omgeving.vlaanderen.be/id/conceptscheme/lucht/temperatuur"
          }
        }
      },
      "then": {
        "properties": {
          "hasResult": {
            "type": "object",
            "required": [
              "hasUnit"
            ],
            "properties": {
              "hasUnit": {
                "enum": [
                  "http://qudt.org/vocab/unit/K",
                  "http://qudt.org/vocab/unit/DEG_C"
                ]
              }
            }
          }
        }
      }
    }
  ]
}