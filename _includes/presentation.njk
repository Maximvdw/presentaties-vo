<!DOCTYPE html>
<html lang="nl">
  {% include "head.njk" %}
  {% set active_theme = theme or defaults.theme or 'vlaanderen' %}
  {# Use the date filter for builddate (Unix timestamp) for cache busting. #}
  {% set builddate = builddate or ('' | date('U')) %}
  <body>
    <link rel="stylesheet" href="{{ site.baseUrl }}/reveal.js/dist/reset.css">
    <link rel="stylesheet" href="{{ site.baseUrl }}/reveal.js/dist/reveal.css">
    {% if active_theme != 'vlaanderen' and active_theme != 'omgeving' and active_theme != 'vlaanderen-international' and active_theme %}
    <link rel="stylesheet" href="/reveal.js/dist/theme/{{ active_theme }}.css">
    {% endif %}
    <link rel="stylesheet" href="{{ site.baseUrl }}/reveal.js/plugin/highlight/monokai.css">
    {% if active_theme == 'vlaanderen' or not active_theme %}
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/vlaanderen-theme.css?{{ builddate }}">
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/vlaanderen-icons.css?{{ builddate }}">
    {% endif %}
    {% if active_theme == 'omgeving' %}
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/vlaanderen-theme.css?{{ builddate }}">
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/omgeving-theme.css?{{ builddate }}">
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/vlaanderen-icons.css?{{ builddate }}">
    {% endif %}
    {% if active_theme == 'vlaanderen-international' %}
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/vlaanderen-theme.css?{{ builddate }}">
    <link rel="stylesheet" href="{{ site.baseUrl }}/css/vlaanderen-international-theme.css?{{ builddate }}">
    {% endif %}
    {% if custom_css %}
    <link rel="stylesheet" href="{{ custom_css }}?{{ builddate }}">
    {% endif %}

    <div class="reveal {% if active_theme == 'omgeving' %}omgeving{% elif active_theme == 'vlaanderen-international' %}vlaanderen-international{% endif %}">
      <div class="slides">
        <div class="slide-corner-icon slide-corner-icon--fixed">
          {% if active_theme == 'vlaanderen-international' %}
          <img src="{{ site.baseUrl }}/images/logo-flanders-state-of-the-art.svg" class="sota-logo" alt="Flanders State of the Art">
          {% else %}
          <i class="vl-vi vl-vi-vlaanderen"></i>
          {% endif %}
        </div>
        {% if not hide_title_slide %}
        <section class="title-slide center" data-timing="15">
          <div class="title-slide-before-bar"></div>
          <div class="slide-wrapper">
            <div class="slide-content">
              <h1>{{ title }}</h1>
              {% if subtitle %}
              <h3>{{ subtitle }}</h3>
              {% endif %}
              {% if author or defaults.author %}
              <p class="author">{{ author or defaults.author }}</p>
              {% endif %}
              {% if organization or defaults.organization %}
              <p class="organization">{{ organization or defaults.organization }}</p>
              {% endif %}
              {% if presentationDate %}
              <p class="date">{{ presentationDate | date('nl-long') }}</p>
              {% endif %}
            </div>
          </div>
        </section>
        {% endif %}

        {{ content | safe }}

      </div>
    </div>

    <script src="{{ site.baseUrl }}/reveal.js/dist/reveal.js"></script>
    <script src="{{ site.baseUrl }}/reveal.js/plugin/notes/notes.js"></script>
    <script src="{{ site.baseUrl }}/reveal.js/plugin/markdown/markdown.js"></script>
    <script src="{{ site.baseUrl }}/reveal.js/plugin/highlight/highlight.js"></script>
    <script src="{{ site.baseUrl }}/reveal.js/plugin/zoom/zoom.js"></script>
    <script src="{{ site.baseUrl }}/reveal.js/plugin/search/search.js"></script>
    
    <!-- Expose Reveal globally for decktape compatibility -->
    <script>
      window.Reveal = Reveal;
    </script>
    
    <script type="module">
      import { default as Mermaid } from '{{ site.baseUrl }}/js/mermaid/mermaid.esm.min.mjs?{{ builddate }}';
      import { initPresentation, initMermaid } from '{{ site.baseUrl }}/js/presentation.js?{{ builddate }}';
      
      // Make mermaid available globally
      window.mermaidInstance = Mermaid;
      
      Mermaid.initialize({ 
        startOnLoad: false, 
        theme: 'default',
        securityLevel: 'loose',
        fontFamily: 'Flanders Art Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif',
        fontSize: 12,
        flowchart: {
          useMaxWidth: true
        },
        themeVariables: {
          fontFamily: 'Flanders Art Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif',
          fontSize: '12px'
        }
      });

      const options = {
        center: false,
        margin: 0.08,
        transition: '{{ transition or defaults.transition or "slide" }}',
        slideNumber: {{ slide_number if slide_number is defined else (defaults.slide_number if defaults.slide_number is defined else 'false') }},
        width: {{ width if width is defined else (defaults.width if defaults.width is defined else 1280) }},
        height: {{ height if height is defined else (defaults.height if defaults.height is defined else 720) }},
        controls: {{ controls if controls is defined else (defaults.controls if defaults.controls is defined else 'true') }},
        progress: {{ progress if progress is defined else (defaults.progress if defaults.progress is defined else 'true') }},
        history: {{ history if history is defined else (defaults.history if defaults.history is defined else 'true') }},
        plugins: [ 
          RevealMarkdown, 
          RevealHighlight, 
          RevealNotes,
          RevealZoom,
          RevealSearch
        ],
        {% if reveal_options %}
        {{ reveal_options | safe }}
        {% endif %}
      };

      // Initialize presentation
      const urlParams = new URLSearchParams(window.location.search);

      if (urlParams.has('presenter') || window.location.search.indexOf('presenter') > -1) {
        // Presenter mode: linear navigation, hide controls and use compact slide numbering
        const presenterOptions = Object.assign({}, options, {
          navigationMode: 'linear',
          slideNumber: 'c',
          controls: false
        });

        console.log('Starting in presenter mode');
        initPresentation({ initialize: () => Reveal.initialize(presenterOptions) });

        // Add presenter-specific behavior after Reveal ready
        Reveal.on('ready', () => {
          // When generating PDF, remove uncounted pages
          Reveal.on && Reveal.on('pdf-ready', () => {
            document.querySelectorAll(`.pdf-page section[data-visibility="uncounted"]`).forEach(e => e.closest('.pdf-page').remove());
          });

          // Ensure linear navigation for slides marked with data-visibility
          Reveal.on('slidechanged', (event) => {
            if (!event.currentSlide) return;
            if (event.currentSlide.hasAttribute('data-visibility') && !Reveal.isOverview()) {
              const prevIndices = Reveal.getIndices(event.previousSlide);
              const currentIndices = Reveal.getIndices(event.currentSlide);
              if (prevIndices.h < currentIndices.h || (prevIndices.h === currentIndices.h && prevIndices.v < currentIndices.v)) {
                Reveal.next();
              } else if (prevIndices.h > currentIndices.h || (prevIndices.h === currentIndices.h && prevIndices.v > currentIndices.v)) {
                Reveal.prev();
              }
            }
          });
        });
      } else {
        initPresentation({ initialize: () => Reveal.initialize(options) });
      }
      
      // Initialize Mermaid configuration first
      if (window.mermaidInstance) {
        initMermaid(window.mermaidInstance);
        
        // Assign unique IDs to all mermaid diagrams
        let diagramCounter = 0;
        document.querySelectorAll('.mermaid').forEach(diagram => {
          if (!diagram.id) {
            diagram.id = `mermaid-${diagramCounter++}`;
          }
        });
        
        const renderedDiagrams = new Set();
        
        // Render diagrams when a slide is shown
        const renderDiagramsOnSlide = async () => {
          const currentSlide = Reveal.getCurrentSlide();
          if (!currentSlide) return;
          
          const diagrams = currentSlide.querySelectorAll('.mermaid');
          
          for (const diagram of diagrams) {
            const diagramId = diagram.id;
            
            // Only render if not already rendered
            if (!renderedDiagrams.has(diagramId)) {
              renderedDiagrams.add(diagramId);
              
              // Wait a tick to ensure layout is ready
              await new Promise(resolve => setTimeout(resolve, 50));
              
              try {
                await window.mermaidInstance.run({
                  nodes: [diagram],
                });
                
                // Setup pan/zoom after rendering
                if (window.setupMermaidPanZoom) {
                  window.setupMermaidPanZoom();
                }
              } catch (error) {
                console.error('Mermaid rendering error for ' + diagramId + ':', error);
              }
            }
          }
        };
        
        // Render on ready and on slide changes
        Reveal.on('ready', renderDiagramsOnSlide);
        Reveal.on('slidechanged', renderDiagramsOnSlide);
      }
    </script>
  </body>
</html>