{
  "name": "@maximvdw/presentaties",
  "version": "1.0.0",
  "type": "module",
  "description": "Reveal.js presentaties met Nunjucks en Eleventy",
  "scripts": {
    "build:css": "npx sass css/vlaanderen-theme.scss:css/vlaanderen-theme.css css/index.scss:css/index.css css/hljs.scss:css/hljs.css css/omgeving-theme.scss:css/omgeving-theme.css css/vlaanderen-icons.scss:css/vlaanderen-icons.css --no-source-map",
    "watch:css": "npx sass --watch css/vlaanderen-theme.scss:css/vlaanderen-theme.css css/index.scss:css/index.css css/hljs.scss:css/hljs.css css/omgeving-theme.scss:css/omgeving-theme.css css/vlaanderen-icons.scss:css/vlaanderen-icons.css --no-source-map",
    "start": "npm run build:css && eleventy --serve --config=.eleventy.js",
    "build": "npm run build:css && eleventy --config=.eleventy.js",
    "ncu:update": "npx npm-check-updates -u",
    "export": "npm run build && node scripts/export-pdf.js"
  },
  "author": "Maxim Van de Wynckel",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "decktape": "^3.15.0",
    "markdown-it": "^14.1.0",
    "markdown-it-mermaid": "^0.2.5",
    "nunjucks-markdown": "^2.0.1",
    "puppeteer": "^24.37.5",
    "serve-handler": "^6.1.6"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "mermaid": "^11.12.2",
    "pdfjs-dist": "^4.10.38",
    "reveal.js": "^5.2.1"
  }
}
